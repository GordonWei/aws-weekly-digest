# Copy this to samconfig.toml and fill in your own values:
#   cp samconfig.toml.example samconfig.toml
# samconfig.toml is in .gitignore, so it never gets committed.
version = 0.1

[default.deploy.parameters]
stack_name = "aws-weekly-digest"
resolve_s3 = true
s3_prefix = "aws-weekly-digest"
region = "ap-northeast-1"
confirm_changeset = true

# CAPABILITY_NAMED_IAM, not CAPABILITY_IAM — the template pins an explicit IAM
# RoleName, and that alone upgrades the requirement to the NAMED variant.
capabilities = "CAPABILITY_NAMED_IAM"

# Both RecipientEmail and SenderEmail must be verified identities in SES.
# In the sandbox you verify both ends; they can be the same address.
#
# Careful: parameter_overrides is one flat string. Drop a parameter from it and
# CloudFormation silently falls back to the template default instead of telling
# you anything — pass all of them every time.
parameter_overrides = "RecipientEmail=\"you@example.com\" SenderEmail=\"you@example.com\" BedrockModelId=\"us.amazon.nova-pro-v1:0\" BedrockRegion=\"us-east-1\" DaysLookback=\"7\" FeatureSendEmail=\"true\" FeatureEmbedContent=\"true\" FeatureSaveToS3=\"true\" FeaturePostToLinkedIn=\"false\" FeaturePostToWebhook=\"false\" DigestLanguage=\"en\" LlmTimeout=\"240\" LlmProvider=\"bedrock\" LlmBaseUrl=\"\" LlmModel=\"\" LlmApiKeyParam=\"/aws-weekly-digest/llm-api-key\""
image_repositories = []
